<h1 class="text-3xl text-center mx-8 my-6 underline decoration-dotted">Checkout Page</h1>
<script src="https://js.stripe.com/v3/"></script>

{{#if cartItems.length}}
  <table class="w-full max-w-4xl mx-auto my-6 border-collapse rounded-lg shadow-lg bg-white">
    <thead>
      <tr class="bg-blue-900 text-white">
        <th class="p-4 text-left rounded-tl-lg">Game</th>
        <th class="p-4 text-left">Condition</th>
        <th class="p-4 text-left">Price</th>
        <th class="p-4 text-left">Quantity</th>
        <th class="p-4 text-left rounded-tr-lg">Total</th>
      </tr>
    </thead>
    <tbody>
      {{#each cartItems}}
        <tr class="border-b hover:bg-gray-50">
          <td class="p-4">{{gamesConsole.game.title}}</td>
          <td class="p-4">{{gamesConsole.condition}}</td>
          <td class="p-4">${{gamesConsole.price}}</td>
          <td class="p-4">{{quantity}}</td>
          <td class="p-4">${{multiply gamesConsole.price quantity}}</td>
        </tr>
      {{/each}}
    </tbody>
    <tfoot>
      <tr class="bg-gray-100 font-semibold">
        <td colspan="4" class="p-4 text-right">Grand Total:</td>
        <td class="p-4">${{calculateTotal cartItems}}</td>
      </tr>
    </tfoot>
  </table>

  <form action="/create-checkout-session" method="POST" class="text-center">
    <button type="submit" class="text-xl text-white bg-blue-900 duration-500 px-6 py-2 mx-4 my-2 hover:bg-cyan-500 rounded-lg">Complete Purchase</button>
  </form>
{{else}}
  <p class="text-3xl text-center mx-8 my-6">Your cart is empty.</p>
{{/if}}